{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibrahimnew",
  // The only server code (see the comment at the top of the file). Built
  // to fit the Workers Free plan.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Keep plain-text variables set in the Cloudflare dashboard when deploying
  // from the CLI (secrets are always kept; this covers the rest).
  "keep_vars": true,
  "assets": {
    // The Next.js static export.
    "directory": "out",
    "binding": "ASSETS",
    // Pages and files are served straight from assets (no Worker
    // invocation, no CPU). Only these paths run the Worker.
    "run_worker_first": ["/api/*", "/media/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      // Events, flier images, and the cached Masjidal response. No id on
      // purpose: wrangler creates the namespace on the first deploy and
      // reuses it after that.
      "binding": "SITE_KV"
    }
  ],
  "observability": {
    "enabled": true
  }
}
